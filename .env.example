# MongoDB connection string for the contact form storage.
# Leave unset to keep the contact form disabled (UI shows a read-only note).
# Example:
#   MONGODB_URI="mongodb+srv://user:pass@cluster.mongodb.net/dennis-porto?retryWrites=true&w=majority"
MONGODB_URI=

# Password for the /admin/login page (single-user admin).
# Pick something long and unique. Plain text is fine for local dev — never
# commit a real value to source control.
ADMIN_PASSWORD=

# 32+ character random string used to HMAC-sign the admin session cookie.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=
